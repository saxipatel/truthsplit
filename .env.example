# Copy to .env and change the passwords. .env is git-ignored.

# Application metadata database (investigations, findings, evidence).
APP_DB_USER=truthsplit
APP_DB_PASSWORD=change-me-app
APP_DB_NAME=truthsplit
APP_DB_PORT=5433

# Demo source database. TruthSplit connects to it only through the read-only role below.
SOURCE_DB_ADMIN_PASSWORD=change-me-source-admin
SOURCE_DB_NAME=shop
SOURCE_DB_PORT=5434
SOURCE_READER_USER=ts_reader
SOURCE_READER_PASSWORD=change-me-reader

# Port for the web UI (nginx serving the built frontend and proxying the API).
WEB_PORT=8080

# Hosts the backend may open source connections to (SSRF guard).
TRUTHSPLIT_ALLOWED_SOURCE_HOSTS=source-db,localhost,127.0.0.1

# Limits
TRUTHSPLIT_MAX_UPLOAD_MB=25
TRUTHSPLIT_MAX_ROWS=250000
TRUTHSPLIT_STATEMENT_TIMEOUT_MS=5000
TRUTHSPLIT_LOG_LEVEL=INFO
